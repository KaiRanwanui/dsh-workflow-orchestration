{
  "name": "@workflow-agent/workflow-host",
  "version": "0.23.0",
  "description": "Workflow Agent Host 端插件 - 提供工作流引擎、工具注册（workflow_begin / workflow_status）与 webServer HTTP 路由（/wf/*）",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./monitor": "./lib/monitor-entry.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/monitor-entry.js",
    "dist/workflow-host.mjs",
    "presets/workflow-orchestrator/",
    "builtin-assets/",
    "src/",
    "build-client.mjs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.js",
    "build:client": "node build-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaiRanwanui/dsh-workflow-orchestration.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
